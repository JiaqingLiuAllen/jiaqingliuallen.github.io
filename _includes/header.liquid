{%- assign socials = site.data.socials -%}
{%- assign is_home = false -%}
{%- if page.permalink == '/' -%}{%- assign is_home = true -%}{%- endif -%}
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-nav{% unless is_home %} show-social{% endunless %}" data-nav>
  <nav class="nav-inner" aria-label="Main">
    <a class="nav-brand" href="{{ '/' | relative_url }}">Jiaqing <span class="nickname">(Allen)</span> Liu</a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-menu" aria-label="Menu" data-nav-toggle><span></span><span></span></button>
    <div class="nav-menu" id="nav-menu">
      <ul class="nav-links">
        <li><a href="{{ '/' | relative_url }}"{% if is_home %} aria-current="page"{% endif %}>About</a></li>
        <li><a href="{{ '/publications/' | relative_url }}"{% if page.permalink == '/publications/' %} aria-current="page"{% endif %}>Publications</a></li>
        <li><a href="{{ '/news/' | relative_url }}"{% if page.permalink == '/news/' %} aria-current="page"{% endif %}>News</a></li>
        <li><a href="{{ '/misc/' | relative_url }}"{% if page.permalink == '/misc/' %} aria-current="page"{% endif %}>Misc</a></li>
      </ul>
      <div class="nav-social" aria-label="Contact and profiles">
        <a href="{{ '/' | relative_url }}#contact" {% include mail_attrs.liquid %} title="Email" aria-label="Email">{% include icon.liquid name="mail" %}</a>
        <a href="https://scholar.google.com/citations?user={{ socials.scholar_userid }}&amp;hl=en" target="_blank" rel="noopener" title="Google Scholar" aria-label="Google Scholar">{% include icon.liquid name="scholar" %}</a>
        <a href="https://www.linkedin.com/in/{{ socials.linkedin_username }}" target="_blank" rel="noopener" title="LinkedIn" aria-label="LinkedIn">{% include icon.liquid name="linkedin" %}</a>
        <a href="https://github.com/{{ socials.github_username }}" target="_blank" rel="noopener" title="GitHub" aria-label="GitHub">{% include icon.liquid name="github" %}</a>
      </div>
    </div>
  </nav>
</header>
