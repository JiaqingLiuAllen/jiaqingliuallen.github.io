{%- assign socials = site.data.socials -%}
<footer class="site-footer">
  <div class="container footer-inner">
    <p>© {{ site.time | date: '%Y' }} Jiaqing (Allen) Liu{% if site.last_updated %}<span class="footer-sep" aria-hidden="true">·</span>Updated {{ site.time | date: '%b %Y' }}{% endif %}</p>
    <div class="footer-links">
      <a href="{{ '/' | relative_url }}#contact" {% include mail_attrs.liquid %}>Email</a>
      <a href="https://scholar.google.com/citations?user={{ socials.scholar_userid }}&amp;hl=en" target="_blank" rel="noopener">Google Scholar</a>
      <a href="https://www.linkedin.com/in/{{ socials.linkedin_username }}" target="_blank" rel="noopener">LinkedIn</a>
      <a href="https://github.com/{{ socials.github_username }}" target="_blank" rel="noopener">GitHub</a>
    </div>
  </div>
</footer>
