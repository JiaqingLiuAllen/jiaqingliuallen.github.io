{%- assign news = site.news | sort: 'date' | reverse -%}
{%- assign news_limit = include.limit | default: news.size -%}
{%- if news.size > 0 -%}
<ul class="list-card card news-list">
  {%- for item in news limit: news_limit -%}
    <li class="news-item">
      <span class="news-emoji" aria-hidden="true">{{ item.emoji | default: '✨' }}</span>
      <div class="news-body">
        <p>{% if item.inline %}{{ item.content | strip | remove: '<p>' | remove: '</p>' }}{% else %}<a href="{{ item.url | relative_url }}">{{ item.title }}</a>{% endif %}</p>
        <time datetime="{{ item.date | date_to_xmlschema }}">{{ item.date | date: '%b %Y' }}</time>
      </div>
    </li>
  {%- endfor -%}
</ul>
{%- else -%}
<p class="muted">No news yet.</p>
{%- endif -%}
