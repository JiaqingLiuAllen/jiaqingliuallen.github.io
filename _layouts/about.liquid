---
layout: default
---
<div class="container home">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-text">
      <p class="hero-greeting enter" style="--i: 0"><img class="hero-avatar" src="{{ '/assets/img/prof_pic_web.jpg' | relative_url }}" width="800" height="960" alt=""><span class="wave" aria-hidden="true">👋</span>Hi, I’m</p>
      <h1 id="hero-title" class="hero-name enter" style="--i: 1">Jiaqing <span class="nickname">(Allen)</span> Liu</h1>
      <p class="hero-tagline enter" style="--i: 2">{{ page.tagline }}</p>
      <div class="hero-bio enter" style="--i: 3">{{ content }}</div>
      <div class="hero-actions enter" style="--i: 4">
        {% include contact_buttons.liquid hero=true %}
        <div class="hero-meta">
          <button class="copy-email" type="button" {% include mail_attrs.liquid %} aria-label="Copy email address" title="Copy email address">
            {% include email_image.liquid %}
            <span class="copy-email-icon">{% include icon.liquid name="copy" %}{% include icon.liquid name="check" %}</span>
            <span class="copy-toast" aria-live="polite">Copied</span>
          </button>
          <span class="hero-meta-sep" aria-hidden="true">·</span>
          <span>CV available upon request</span>
        </div>
      </div>
    </div>
    <div class="hero-photo enter" style="--i: 2">
      <div class="hero-aura" aria-hidden="true"></div>
      <img src="{{ '/assets/img/prof_pic_web.jpg' | relative_url }}" width="800" height="960" alt="Allen standing under cherry blossoms" fetchpriority="high">
    </div>
  </section>

  {% if page.selected_papers %}
    <section class="section" id="publications" aria-labelledby="pubs-title">
      <div class="section-head">
        <h2 id="pubs-title">Selected Publications</h2>
        <a class="link-more" href="{{ '/publications/' | relative_url }}">See all{% include icon.liquid name="chevron" %}</a>
      </div>
      {% include selected_papers.liquid %}
    </section>
  {% endif %}

  {% if page.announcements.enabled %}
    {%- assign news_size = site.news | size -%}
    <section class="section" id="news" aria-labelledby="news-title" data-reveal>
      <div class="section-head">
        <h2 id="news-title">News</h2>
        {% if news_size > page.announcements.limit %}
          <a class="link-more" href="{{ '/news/' | relative_url }}">See all{% include icon.liquid name="chevron" %}</a>
        {% endif %}
      </div>
      {% include news.liquid limit=page.announcements.limit %}
    </section>
  {% endif %}

  <section class="contact-band" id="contact" aria-labelledby="contact-title" data-reveal>
    <div class="contact-glow" aria-hidden="true"></div>
    <h2 id="contact-title">Let’s connect.</h2>
    <p>{{ site.contact_note | strip }} Feel free to reach out about wearables, health sensing, or AI.</p>
    {% include contact_buttons.liquid center=true %}
  </section>
</div>
