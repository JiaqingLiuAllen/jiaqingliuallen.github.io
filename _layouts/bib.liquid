---
---
{%- comment -%} One publication card. Metadata lives in _bibliography/papers.bib. {%- endcomment -%}
{%- assign main_link = entry.website | default: entry.html -%}
{%- if main_link == nil or main_link == '' -%}
  {%- if entry.doi -%}{%- capture main_link -%}https://doi.org/{{ entry.doi }}{%- endcapture -%}
  {%- elsif entry.pdf -%}{%- assign main_link = entry.pdf -%}
  {%- endif -%}
{%- endif -%}
{%- assign proceedings = 'inproceedings,incollection' | split: ',' -%}
{%- if entry.type == 'article' -%}{%- assign venue = entry.journal -%}
{%- elsif proceedings contains entry.type -%}{%- assign venue = entry.booktitle -%}
{%- else -%}{%- assign venue = '' -%}
{%- endif -%}
<div class="pub-reveal" data-reveal>
<article class="pub card" id="{{ entry.key }}">
  {%- if entry.preview -%}
    {%- if entry.preview contains '://' -%}{%- assign preview_src = entry.preview -%}
    {%- else -%}{%- assign preview_src = entry.preview | prepend: '/assets/img/publication_preview/' | relative_url -%}
    {%- endif -%}
    <a class="pub-thumb" href="{{ main_link }}" tabindex="-1" aria-hidden="true"{% if main_link contains '://' %} target="_blank" rel="noopener"{% endif %}>
      <img src="{{ preview_src }}" alt="" loading="lazy" decoding="async">
    </a>
  {%- endif -%}
  <div class="pub-body">
    <div class="pub-meta">
      {%- if entry.abbr -%}<span class="pub-venue">{{ entry.abbr }}</span>{%- endif -%}
      {%- if entry.award -%}<span class="pub-award">{{ entry.award_name | default: 'Award' }}</span>{%- endif -%}
    </div>
    <h3 class="pub-title">
      {%- if main_link -%}<a href="{{ main_link }}"{% if main_link contains '://' %} target="_blank" rel="noopener"{% endif %}>{{ entry.title }}</a>{%- else -%}{{ entry.title }}{%- endif -%}
    </h3>
    {%- if entry.summary -%}<p class="pub-summary">{{ entry.summary }}</p>{%- endif -%}
    <p class="pub-authors">
      {%- for author in entry.author_array -%}
        {%- assign author_last = author.last | regex_replace: '[*∗†‡§¶‖&^]', '' -%}
        {%- assign author_last_html = author.last | regex_replace: '([*∗†‡§¶‖&^]+)', '<sup>\1</sup>' -%}
        {%- assign is_me = false -%}
        {%- if site.scholar.last_name contains author_last and site.scholar.first_name contains author.first -%}{%- assign is_me = true -%}{%- endif -%}
        {%- unless forloop.first -%}
          {%- if forloop.last -%}{% if forloop.length > 2 %},{% endif %} and {% else %}, {% endif -%}
        {%- endunless -%}
        {%- if is_me -%}<span class="me">{{ author.first }} {{ author_last_html }}</span>{%- else -%}{{ author.first }} {{ author_last_html }}{%- endif -%}
      {%- endfor -%}
    </p>
    {%- if venue != '' or entry.year -%}
      <p class="pub-venue-full">{{ venue }}{% if venue != '' and entry.year %}, {% endif %}{{ entry.year }}</p>
    {%- endif -%}
    <div class="pub-links">
      {%- if entry.pdf -%}<a class="chip" href="{% if entry.pdf contains '://' %}{{ entry.pdf }}{% else %}{{ entry.pdf | prepend: '/assets/pdf/' | relative_url }}{% endif %}" target="_blank" rel="noopener">PDF</a>{%- endif -%}
      {%- if entry.website -%}<a class="chip" href="{{ entry.website }}" target="_blank" rel="noopener">Project page</a>{%- endif -%}
      {%- if entry.doi -%}<a class="chip" href="https://doi.org/{{ entry.doi }}" target="_blank" rel="noopener">DOI</a>{%- endif -%}
      {%- if entry.arxiv -%}<a class="chip" href="https://arxiv.org/abs/{{ entry.arxiv }}" target="_blank" rel="noopener">arXiv</a>{%- endif -%}
      {%- if entry.code -%}<a class="chip" href="{{ entry.code }}" target="_blank" rel="noopener">Code</a>{%- endif -%}
      {%- if entry.video -%}<a class="chip" href="{{ entry.video }}" target="_blank" rel="noopener">Video</a>{%- endif -%}
      {%- if entry.slides -%}<a class="chip" href="{% if entry.slides contains '://' %}{{ entry.slides }}{% else %}{{ entry.slides | prepend: '/assets/pdf/' | relative_url }}{% endif %}" target="_blank" rel="noopener">Slides</a>{%- endif -%}
      {%- if entry.poster -%}<a class="chip" href="{% if entry.poster contains '://' %}{{ entry.poster }}{% else %}{{ entry.poster | prepend: '/assets/pdf/' | relative_url }}{% endif %}" target="_blank" rel="noopener">Poster</a>{%- endif -%}
      {%- if entry.abstract -%}<button class="chip" type="button" data-panel-toggle aria-expanded="false" aria-controls="abs-{{ entry.key }}">Abstract</button>{%- endif -%}
      {%- if entry.bibtex_show -%}<button class="chip" type="button" data-panel-toggle aria-expanded="false" aria-controls="bib-{{ entry.key }}">BibTeX</button>{%- endif -%}
    </div>
    {%- if entry.abstract -%}
      <div class="pub-panel" id="abs-{{ entry.key }}">
        <div class="pub-panel-inner"><p class="pub-abstract">{{ entry.abstract }}</p></div>
      </div>
    {%- endif -%}
    {%- if entry.bibtex_show -%}
      <div class="pub-panel" id="bib-{{ entry.key }}">
        <div class="pub-panel-inner">
          <div class="bibtex">
            <button class="bibtex-copy" type="button" data-copy-target="#bib-{{ entry.key }} code"><span data-copy-label>Copy</span></button>
            <pre><code>{{ entry.bibtex | hideCustomBibtex | strip | escape }}</code></pre>
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
</article>
</div>
